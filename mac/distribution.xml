<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>SKAZI Bundle</title>
    <organization>com.skazi</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="apps"/>
    </choices-outline>

    <choice id="vst3" title="VST3 plugins" description="All SKAZI plugins as VST3, in /Library/Audio/Plug-Ins/VST3/SKAZI">
        <pkg-ref id="com.skazi.bundle.vst3"/>
    </choice>
    <choice id="au" title="Audio Units (Logic, GarageBand, Ableton)" description="All SKAZI plugins as Audio Units, in /Library/Audio/Plug-Ins/Components">
        <pkg-ref id="com.skazi.bundle.au"/>
    </choice>
    <choice id="apps" title="Standalone apps" description="Every SKAZI plugin as an app, in /Applications/SKAZI">
        <pkg-ref id="com.skazi.bundle.apps"/>
    </choice>

    <pkg-ref id="com.skazi.bundle.vst3" version="1.0.0">vst3.pkg</pkg-ref>
    <pkg-ref id="com.skazi.bundle.au" version="1.0.0">au.pkg</pkg-ref>
    <pkg-ref id="com.skazi.bundle.apps" version="1.0.0">apps.pkg</pkg-ref>
</installer-gui-script>
